{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container", "height": 400,
    "data": {"url": "data/BankNotes.csv"},
    "title": {
      "text": "Total Value of Banknotes in Circulation",
      "fontSize": 35,
      "subtitle": "Click on legend items to filter denominations",
      "subtitleFontStyle": "italic",
      "subtitleColor": "gray",
      "subtitleFontSize": 20
  },
  "layer": [
    {
    "mark": "area",
    "params": [{
      "name": "BankNotes",
      "select": {"type": "point", "fields": ["Attribute"]},
      "bind": "legend"
    }],
    "encoding": {
      "x": {
        "timeUnit": "yearmonth", "field": "Date",
        "axis": {"domain": false, "format": "%Y", "tickSize": 0},
        "title": "Date"
      },
      "y": {
        "aggregate": "sum", "field": "Value",
        "stack": "center", "axis": {"labels": false, "ticks": false, "domain": false, "grid": false},
        "title": "Total Value of Banknotes ($millions)"
      },
      "color": {
        "field":"Attribute",
        "scale": {
            "domain": ["$5 notes", "$10 notes", "$20 notes", "$50 notes", "$100 notes"],
            "range": ["#E91E63", "#2196F3", "#FF5722", "#FFC107", "#4CAF50"]
      },
        "title": "Banknote Denomination"
      },
      "opacity": {
        "condition": {"param": "BankNotes", "value": 1},
        "value": 0.2
      },
      "tooltip": [	
        {"field": "Date", "type": "temporal", "title": "Date"},
        {"field": "Value", "type": "quantitative", "title": "Total Value of Banknotes ($millions)", "format": ",.0f"},
        {"field": "Attribute", "type": "nominal", "title": "Banknote Denomination"}
      ]
    }
  },
  {
    "data": {"values": [{}]},
    "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 0,
        "fontSize": 12,
        "fill": "white"
    },
    "encoding": {
        "x": {"datum": {"year": 2010, "month": 3}},
        "y": {"datum": 71000},
        "text": {"value": "$100 notes have the most value in circulation currently"}
    }
},
{
  "data": {"values": [{}]},
  "mark": {
      "type": "text",
      "align": "left",
      "dx": 10,
      "dy": 0,
      "fontSize": 12,
      "fill": "black"
  },
  "encoding": {
      "x": {"datum": {"year": 2010, "month": 3}},
      "y": {"datum": 45000},
      "text": {"value": "$5 notes have the least value in circulation currently"}
  }
}

  ]
  }