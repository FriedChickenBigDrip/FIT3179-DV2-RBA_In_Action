{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 700,
    "title": {
      "text": "Unemployment Rate (%) by Region in Australia",
      "fontSize": 35,
      "subtitle": "Use the controls to filter the data",
      "subtitleFontStyle": "italic",
      "subtitleColor": "gray",
      "subtitleFontSize": 20
  },
  "params": [
    {
      "name": "Year_selection",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 2012,
        "max": 2024,
        "step": 1,
        "name": "Year:  "
      }
    },
    {
      "name": "Month_selection",
      "value": 8,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 11,
        "step": 1,
        "name": "Month:  "
      }
    },
    {
      "name": "Gender_selection",
      "value": "Males",
      "bind": {
        "input": "select",
        "options": [

          "Males",
          "Females"
        ],
        "labels": [

          "Males",
          "Females"
        ],
        "name": "Sex: "
      }
    },
    {
      "name": "Age_selection",
      "value": "15-24 years",
      "bind": {
        "input": "select",
        "options": [

          "15-24 years",
          "25-34 years",
          "35-44 years",
          "45-54 years",
          "55-64 years",
          "65 years and over"
        ],
        "labels": [

          "15-24 years",
          "25-34 years",
          "35-44 years",
          "45-54 years",
          "55-64 years",
          "65 years and over"
        ],
        "name": "Age Group: "
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [133, -27],
    "scale": 850
  },
  "layer": [
    {
      "data": {
        "url": "js/SA4_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "SA4_2021_AUST_GDA2020"}
      },
      "transform": [
        {
          "calculate": "'Data is not available in ' + datum.properties.SA4_NAME21",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ddd",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {"tooltip": {"field": "note"}}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {"type": "topojson", "feature": "oceans"}
      },
      "mark": {"type": "geoshape", "fill": "skyblue"}
    },
    {
      "data": {
        "url": "data/unemployment.csv"
      },
      "transform": [
        {
          "calculate": "year(datum.Month)",
          "as": "Year"
        },
        {
          "calculate": "month(datum.Month)",
          "as": "MonthNum"
        },
        {
          "lookup": "Labour market region (SA4): ASGS (2011)",
          "from": {
            "data": {
              "url": "js/SA4_2021_AUST_GDA2020.json",
              "format": {
                "type": "topojson",
                "feature": "SA4_2021_AUST_GDA2020"
              }
            },
            "key": "properties.SA4_NAME21"
          },
          "as": "geo"
        },
        {"filter": "datum.MonthNum == Month_selection"},
        {"filter": "datum.Year == Year_selection"},
        {"filter": "Gender_selection == null || datum.Sex == Gender_selection"},
        {"filter": "Age_selection == null || datum.Age == Age_selection"}
      ],
      "mark": {"type": "geoshape", "stroke": "#fff", "strokeWidth": 0.5},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "Unemployment rate (%)",
          "type": "quantitative",
"scale": {
  "type": "threshold",
  "domain": [0, 2, 4, 6, 8, 10, 15, 20, 25],
  "range": ["#fee5d9", "#fcbba1", "#fc9272", "#fb6a4a", "#ef3b2c", "#cb181d", "#99000d", "#67000d","#320000","#000000"]
},
          "legend": {
            "title": "Unemployment %",
            "orient": "right"
          },
          "title": "Unemployment Rate (%)"
        },
        "tooltip": [
          {"field": "Labour market region (SA4): ASGS (2011)", "type": "nominal", "title": "Region"},
          {"field": "Month", "type": "temporal", "title": "Date"},
          {"field": "Age", "type": "nominal", "title": "Age Group"},
          {"field": "Sex", "type": "nominal", "title": "Sex"},
          {"field": "Unemployment rate (%)", "type": "quantitative", "title": "Unemployment Rate (%)", "format": ".2f"}
        ]
      }
    }
  ],
  "config": {}
}
