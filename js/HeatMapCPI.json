{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
        "url": "data/CPI.csv"
    },
    "width": "container",
    "height": 400,
    "title": "Quarter on Quarter % Change in CPI",
    "config": {
        "view": {
            "strokeWidth": 0,
            "step": 13
        },
        "axis": {
            "domain": false
        }
    },
    
    "layer": [
        {
    "mark": "rect",
    "encoding": {
        "x": {
            "field": "Series_ID",
            "type": "temporal",
            "timeUnit": "yearquarter",
            "title": "Quarterly Observation",
            "axis": {
                "labelAngle": 0
            }
        },
        "y": {  
            "field": "Attribute",
            "type": "ordinal",
            "title": "CPI Category"
        },
        "color": {
            "field": "Value",
            "scale": {"scheme": "redyellowgreen", "domain": [-25, 25]},
            "aggregate": "mean",
            "type": "quantitative",
            "legend": {
                "title": "CPI % Change",
                "direction": "horizontal",
                "titleAnchor": "middle"
            }
        },
        "tooltip": [
            {"field": "Series_ID", "type": "temporal", "title": "Quarterly Observations"},
            {"field": "Attribute", "type": "nominal", "title": "CPI Category"},
            {"field": "Value", "type": "quantitative", "title": "CPI % Change", "format": ".2f"}
        ]
    }

    },
    {
        "data": {"values": [{}]},
        "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "dy": -5,
            "fontSize": 12
        },
        "encoding": {
            "x": {"datum": {"year": 2016, "month": 11, "day": 1}},
            "y": {"datum": "Electricity"},
            "text": {"value": "Impact of Heatwave"}
        }
    },
    {
        "data": {"values": [{}]},
        "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "dy": -5,
            "fontSize": 12
        },
        "encoding": {
            "x": {"datum": {"year": 2022, "month": 8, "day": 1}},
            "y": {"datum": "Beef and Veal"},
            "text": {"value": "Surplus Cattle Supply"}
        }
    }
    ]
  }